# Salin menjadi .env lalu sesuaikan bila perlu.
# Semua nilai opsional; aplikasi memakai default bila tidak diisi.

PORT=3000
DB_PATH=./database/foodlink.db
STORAGE_DIR=./storage/dokumen

# Kunci rahasia untuk mengamankan sesi login pengguna.
# Jika dikosongkan, semua pengguna akan otomatis ter-logout setiap kali server di-restart.
# Isi dengan teks acak yang panjang.
SESSION_SECRET=