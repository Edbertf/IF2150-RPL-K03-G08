<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Dashboard - FoodLink</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #79b549;
            --primary-dark: #4a6b36;
            --primary-soft: #e6f0df;
            --orange: #e8842e;
            --bg: #f7faf3;
            --surface: #ffffff;
            --text: #2f332c;
            --muted: #767c73;
            --border: #e5e9e1;
            --input-bg: #f4f7f1;
            --sidebar-width: 250px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            display: flex;
            min-height: 100vh;
            background-color: var(--bg);
            color: var(--text);
            font-family: 'Nunito', system-ui, -apple-system, 'Segoe UI', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .sidebar {
            position: sticky;
            top: 0;
            display: flex;
            flex: 0 0 var(--sidebar-width);
            flex-direction: column;
            width: var(--sidebar-width);
            height: 100vh;
            padding: 22px 20px 18px;
            overflow-y: auto;
            background-color: var(--surface);
            border-right: 1px solid var(--border);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 34px;
            padding-left: 4px;
            text-decoration: none;
        }

        .brand-logo {
            display: block;
            width: 40px;
            height: 40px;
            flex: 0 0 40px;
        }

        .brand-text {
            font-size: 21px;
            font-weight: 800;
            letter-spacing: -0.4px;
            line-height: 1;
        }

        .brand-text .food {
            color: var(--orange);
        }

        .brand-text .link {
            color: var(--primary);
        }

        .nav-menu {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 8px;
            color: var(--muted);
            font-size: 15px;
            font-weight: 700;
            line-height: 1;
            text-decoration: none;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

        .nav-item svg {
            flex: 0 0 20px;
            width: 20px;
            height: 20px;
        }

        .nav-item:hover {
            background-color: var(--input-bg);
            color: var(--primary-dark);
        }

        .nav-item.active {
            background-color: #e8f3df;
            color: #5f9136;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: auto;
            padding: 12px;
            border-radius: 10px;
            background-color: #f4f6f2;
        }

        .user-avatar {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            flex: 0 0 38px;
            border-radius: 50%;
            background-color: #fdebd0;
            color: var(--orange);
            font-size: 15px;
            font-weight: 800;
        }

        .user-info {
            min-width: 0;
        }

        .user-info .name {
            max-width: 118px;
            font-size: 14px;
            font-weight: 800;
            line-height: 1.25;
        }

        .user-info .role {
            margin-top: 2px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        .main-content {
            flex: 1;
            width: 100%;
            padding: 40px 44px 64px;
        }

        .page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 26px;
        }

        .greeting {
            color: var(--muted);
            font-size: 15px;
            font-weight: 600;
        }

        .page-header h1 {
            margin-top: 2px;
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -0.6px;
            line-height: 1.2;
        }

        .header-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 44px;
            padding: 0 22px;
            border: none;
            border-radius: 8px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
            transition: background-color 0.15s ease;
        }

        .btn-primary {
            background-color: var(--primary);
            color: #ffffff;
        }

        .btn-primary:hover {
            background-color: #6aa63f;
        }

        .btn-disabled {
            background-color: #f2e6d8;
            color: #b98b5e;
            cursor: not-allowed;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
            margin-bottom: 22px;
        }

        .stat-card {
            padding: 22px 26px;
            background-color: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .stat-value {
            font-size: 36px;
            font-weight: 800;
            letter-spacing: -1px;
            line-height: 1.1;
        }

        .stat-value.orange {
            color: var(--orange);
        }

        .stat-value.green {
            color: var(--primary);
        }

        .stat-label {
            margin-top: 6px;
            color: var(--muted);
            font-size: 14px;
            font-weight: 600;
        }

        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
            gap: 20px;
            align-items: start;
        }

        .card {
            padding: 22px 26px;
            background-color: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 18px;
        }

        .card-title {
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.2px;
        }

        .card-unit {
            color: var(--muted);
            font-size: 13px;
            font-weight: 600;
        }

        .chart {
            display: flex;
            align-items: flex-end;
            gap: 14px;
            height: 210px;
            padding-top: 8px;
        }

        .bar-col {
            display: flex;
            flex: 1;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            min-width: 0;
            height: 100%;
        }

        .bar-track {
            display: flex;
            flex: 1;
            align-items: flex-end;
            width: 100%;
            min-height: 0;
        }

        .bar {
            width: 100%;
            min-height: 4px;
            border-radius: 6px 6px 0 0;
            background-color: var(--primary);
        }

        .bar.today {
            background-color: var(--orange);
        }

        .bar-label {
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
        }

        .bar-label.today {
            color: var(--orange);
        }

        .badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
        }

        .badge-aktif {
            background-color: var(--primary-soft);
            color: var(--primary-dark);
        }

        .badge-kunci {
            background-color: #eef0ec;
            color: var(--muted);
        }

        .rec-list {
            display: flex;
            flex-direction: column;
        }

        .rec-item {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 0;
            border-top: 1px solid var(--border);
        }

        .rec-item:first-child {
            padding-top: 4px;
            border-top: none;
        }

        .rec-name {
            font-size: 15px;
            font-weight: 700;
        }

        .rec-value {
            display: flex;
            align-items: baseline;
            gap: 8px;
            white-space: nowrap;
        }

        .rec-porsi {
            font-size: 15px;
            font-weight: 800;
        }

        .tren {
            font-size: 12px;
            font-weight: 800;
        }

        .tren.naik {
            color: var(--primary);
        }

        .tren.turun {
            color: var(--orange);
        }

        .tren.stabil {
            color: var(--muted);
            font-weight: 700;
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 10px 6px 6px;
            text-align: center;
        }

        .lock-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            margin-bottom: 14px;
            border-radius: 50%;
            background-color: var(--input-bg);
            color: var(--muted);
        }

        .empty-title {
            max-width: 320px;
            font-size: 15px;
            font-weight: 800;
            line-height: 1.45;
        }

        .empty-text {
            max-width: 320px;
            margin-top: 8px;
            color: var(--muted);
            font-size: 13.5px;
            font-weight: 600;
            line-height: 1.55;
        }

        .empty-progress {
            width: 100%;
            max-width: 300px;
            margin-top: 16px;
            text-align: left;
        }

        .progress-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 7px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
        }

        .progress-bar-container {
            height: 8px;
            border-radius: 999px;
            background-color: var(--input-bg);
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            border-radius: 999px;
            background-color: var(--primary);
        }

        .link-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 42px;
            padding: 0 20px;
            margin-top: 18px;
            border-radius: 8px;
            background-color: var(--primary);
            color: #ffffff;
            font-size: 13.5px;
            font-weight: 800;
            text-decoration: none;
            transition: background-color 0.15s ease;
        }

        .link-cta:hover {
            background-color: #6aa63f;
        }

        @media (max-width: 1100px) {
            .content-grid {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        @media (max-width: 860px) {
            body {
                flex-direction: column;
            }

            .sidebar {
                position: static;
                width: 100%;
                height: auto;
                flex: none;
                flex-direction: row;
                flex-wrap: wrap;
                align-items: center;
                gap: 14px;
                padding: 14px 18px;
            }

            .brand {
                margin-bottom: 0;
                padding-left: 0;
            }

            .nav-menu {
                flex-direction: row;
                flex-wrap: wrap;
                gap: 4px;
            }

            .nav-item {
                padding: 9px 12px;
            }

            .user-profile {
                margin-top: 0;
                margin-left: auto;
            }

            .main-content {
                padding: 28px 20px 48px;
            }

            .stat-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 560px) {
            .user-profile {
                display: none;
            }

            .stat-grid {
                grid-template-columns: minmax(0, 1fr);
            }

            .page-header h1 {
                font-size: 25px;
            }

            .chart {
                gap: 8px;
            }
        }
    </style>
</head>
<body>
<%
    const infoProgres = (typeof progres !== 'undefined' && progres) ? progres : { terisi: 0, target: 7 };
    const target = Number(infoProgres.target) || 7;
    const terisi = Number(infoProgres.terisi) || 0;
    const persenBar = (typeof persen !== 'undefined' && typeof persen === 'number')
        ? Math.max(0, Math.min(100, persen))
        : Math.min(100, Math.round((terisi / target) * 100));

    const infoRingkasan = (typeof ringkasan !== 'undefined' && ringkasan)
        ? ringkasan
        : { terjual: 0, tersisa: 0 };

    const dataGrafik = (typeof grafik !== 'undefined' && Array.isArray(grafik)) ? grafik : [];
    const hasil = (typeof hasilPrediksi !== 'undefined' && Array.isArray(hasilPrediksi)) ? hasilPrediksi : [];
    const errorPrediksi = (typeof pesanError !== 'undefined' && pesanError) ? pesanError : null;

    const sapaanTampil = (typeof sapaan !== 'undefined' && sapaan) ? sapaan : 'Selamat datang,';
    const usahaTampil = (typeof namaUsaha !== 'undefined' && namaUsaha) ? namaUsaha : 'Pemilik F&B';
    const hurufAvatar = usahaTampil.trim().charAt(0).toUpperCase() || 'F';
%>

    <aside class="sidebar">
        <a class="brand" href="/fnb/dashboard" aria-label="FoodLink - Dashboard">
            <img class="brand-logo" src="/assets/logo.png" alt="" width="40" height="40">
            <span class="brand-text"><span class="food">Food</span><span class="link">Link</span></span>
        </a>

        <nav class="nav-menu" aria-label="Navigasi utama">
            <a class="nav-item active" href="/fnb/dashboard" aria-current="page">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M5 20V10m7 10V4m7 16v-7"/>
                </svg>
                <span>Dashboard</span>
            </a>

            <a class="nav-item" href="/fnb/penjualan">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M6 3h8l4 4v14H6zM14 3v4h4"/>
                </svg>
                <span>Penjualan</span>
            </a>

            <a class="nav-item" href="#">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10"/>
                </svg>
                <span>Surplus</span>
            </a>

            <a class="nav-item" href="#">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c0-4 4-6 8-6s8 2 8 6"/>
                </svg>
                <span>Profil</span>
            </a>
        </nav>

        <div class="user-profile">
            <div class="user-avatar" aria-hidden="true"><%= hurufAvatar %></div>
            <div class="user-info">
                <div class="name"><%= usahaTampil %></div>
                <div class="role">Pemilik F&amp;B</div>
            </div>
        </div>
    </aside>

    <main class="main-content">
        <header class="page-header">
            <div>
                <p class="greeting"><%= sapaanTampil %></p>
                <h1><%= usahaTampil %></h1>
            </div>

            <div class="header-actions">
                <a class="btn btn-primary" href="/fnb/penjualan">Catat Penjualan</a>
                <button class="btn btn-disabled" type="button" disabled
                        title="Segera hadir bersama fitur produk surplus">Catat Surplus</button>
            </div>
        </header>

        <section class="stat-grid" aria-label="Ringkasan operasional hari ini">
            <div class="stat-card">
                <div class="stat-value"><%= infoRingkasan.terjual %></div>
                <div class="stat-label">Terjual hari ini</div>
            </div>
            <div class="stat-card">
                <div class="stat-value orange"><%= infoRingkasan.tersisa %></div>
                <div class="stat-label">Sisa produk</div>
            </div>
            <div class="stat-card">
                <div class="stat-value green">0</div>
                <div class="stat-label">Surplus aktif</div>
            </div>
        </section>

        <div class="content-grid">
            <section class="card" aria-label="Penjualan tujuh hari terakhir">
                <div class="card-header">
                    <h2 class="card-title">Penjualan 7 Hari Terakhir</h2>
                    <span class="card-unit">porsi</span>
                </div>

                <div class="chart">
                    <% dataGrafik.forEach(function (item) { %>
                        <%
                            const tinggiBar = Math.max(Number(item.persen) || 0, 2);
                            const kelasHariIni = item.hariIni ? 'today' : '';
                        %>
                        <div class="bar-col">
                            <div class="bar-track">
                                <div class="bar <%= kelasHariIni %>" style="height: <%= tinggiBar %>%"></div>
                            </div>
                            <span class="bar-label <%= kelasHariIni %>"><%= item.label %></span>
                        </div>
                    <% }); %>
                </div>
            </section>

            <section class="card" aria-label="Rekomendasi produksi besok">
                <div class="card-header">
                    <h2 class="card-title">Rekomendasi Produksi Besok</h2>
                    <span class="badge <%= errorPrediksi ? 'badge-kunci' : 'badge-aktif' %>">
                        <%= errorPrediksi ? 'Belum aktif' : 'Prediksi aktif' %>
                    </span>
                </div>

                <% if (errorPrediksi) { %>
                    <div class="empty-state">
                        <div class="lock-icon" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 focusable="false">
                                <rect x="4" y="10" width="16" height="10" rx="2"/>
                                <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
                            </svg>
                        </div>

                        <p class="empty-title"><%= errorPrediksi %></p>
                        <p class="empty-text">
                            Lengkapi data penjualan harian agar sistem dapat menghitung rekomendasi produksi.
                        </p>

                        <div class="empty-progress">
                            <div class="progress-header">
                                <span>Data terkumpul</span>
                                <span><%= terisi %>/<%= target %> hari</span>
                            </div>
                            <div class="progress-bar-container" role="progressbar"
                                 aria-valuemin="0" aria-valuemax="<%= target %>" aria-valuenow="<%= terisi %>">
                                <div class="progress-bar" style="width: <%= persenBar %>%"></div>
                            </div>
                        </div>

                        <a class="link-cta" href="/fnb/penjualan">Catat Penjualan Hari Ini</a>
                    </div>
                <% } else if (hasil.length === 0) { %>
                    <p class="empty-text">Belum ada rekomendasi produksi untuk saat ini.</p>
                <% } else { %>
                    <div class="rec-list">
                        <% hasil.forEach(function (item) { %>
                            <div class="rec-item">
                                <span class="rec-name"><%= item.namaProduk %></span>
                                <span class="rec-value">
                                    <span class="rec-porsi"><%= item.jumlahRekomendasi %> porsi</span>
                                    <% if (item.tren === null || item.tren === undefined) { %>
                                    <% } else if (item.tren > 0) { %>
                                        <span class="tren naik" title="Dibanding penjualan terakhir">naik <%= item.tren %></span>
                                    <% } else if (item.tren < 0) { %>
                                        <span class="tren turun" title="Dibanding penjualan terakhir">turun <%= Math.abs(item.tren) %></span>
                                    <% } else { %>
                                        <span class="tren stabil" title="Dibanding penjualan terakhir">stabil</span>
                                    <% } %>
                                </span>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </section>
        </div>
    </main>
</body>
</html>