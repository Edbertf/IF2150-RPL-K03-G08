                    <span class="summary-label">Produk</span>
                    <span class="summary-value"><%= typeof data !== 'undefined' ? data.namaProduk : 'Roti Tawar' %></span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Jumlah</span>
                    <span class="summary-value"><%= typeof data !== 'undefined' ? data.jumlah : '12' %> porsi</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Ambil sebelum</span>
                    <span class="summary-value"><%= typeof data !== 'undefined' ? data.ambilSebelum : 'Hari ini, 20.00' %></span>
                </div>
            </div>

            <div class="tabs">
                <button type="button" class="tab-btn active" id="tabDonasi">Donasi</button>
                <button type="button" class="tab-btn" id="tabDiskon">Jual Diskon</button>
            </div>

            <form action="/surplus/publikasi" method="POST" id="formDistribusi">
                <input type="hidden" name="metode" id="inputMetode" value="donasi">
