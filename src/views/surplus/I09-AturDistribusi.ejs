                    </div>
                    <div class="metode-text">
                        <h3>Donasi Gratis</h3>
                        <p>Produk ditampilkan gratis untuk NGO. Tidak perlu mengisi harga.</p>
                    </div>
                </div>

                <div class="metode-info diskon" id="infoDiskon">
                    <div class="metode-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                    </div>
                    <div class="metode-text">
                        <h3>Jual dengan Diskon</h3>
                        <p>Produk dijual murah agar tetap terpakai.</p>
                    </div>
                </div>

                <div id="formDiskon">
                    <label class="form-label">Harga Jual per Porsi (Rp)</label>
                    <input type="text" name="hargaJual" id="inputHarga" class="form-control" placeholder="Rp 0">
                    <span class="input-hint">Harga harus berupa angka lebih dari 0.</span>

                    <div class="kalkulasi-box">
                        <div class="kalkulasi-row">
                            <span>Harga normal</span>
                            <span class="value" id="valHargaNormal" data-normal="16000">Rp 16.000</span>
                        </div>
                        <div class="kalkulasi-row">
                            <span>Hemat</span>
                            <span class="value" id="valHemat">0%</span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Simpan</button>
                <a href="javascript:history.back()" class="btn btn-outline" style="text-decoration:none;">Kembali</a>
            </form>
        </section>
    </main>

    <script>
        const tabDonasi = document.getElementById('tabDonasi');
        const tabDiskon = document.getElementById('tabDiskon');
        const infoDonasi = document.getElementById('infoDonasi');
        const infoDiskon = document.getElementById('infoDiskon');
        const formDiskon = document.getElementById('formDiskon');
        const inputMetode = document.getElementById('inputMetode');
        
        tabDonasi.addEventListener('click', () => {
            tabDonasi.classList.add('active');
            tabDiskon.classList.remove('active');
            infoDonasi.style.display = 'flex';
            infoDiskon.style.display = 'none';
            formDiskon.style.display = 'none';
            inputMetode.value = 'donasi';
        });

        tabDiskon.addEventListener('click', () => {
            tabDiskon.classList.add('active');
            tabDonasi.classList.remove('active');
            infoDonasi.style.display = 'none';
            infoDiskon.style.display = 'flex';
            formDiskon.style.display = 'block';
            inputMetode.value = 'diskon';
        });

        const inputHarga = document.getElementById('inputHarga');
        const valHemat = document.getElementById('valHemat');
        const hargaNormal = parseInt(document.getElementById('valHargaNormal').getAttribute('data-normal'));

        inputHarga.addEventListener('input', function(e) {
            let num = parseInt(this.value.replace(/\D/g, '')) || 0;
            this.value = num > 0 ? 'Rp ' + num.toLocaleString('id-ID') : '';
            if (num > 0 && num < hargaNormal) {
                let persen = Math.round(((hargaNormal - num) / hargaNormal) * 100);
                valHemat.textContent = persen + '%';
            } else {
                valHemat.textContent = '0%';
            }
        });
    </script>
</body>
