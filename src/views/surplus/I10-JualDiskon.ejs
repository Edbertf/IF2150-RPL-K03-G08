<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>FoodLink - Jual Diskon</title>
    <link rel="stylesheet" href="/app.css">
</head>
<body>
    <div class="app">
        <aside class="side">
            <div class="brand"><img src="/logo.png"><span><b>Food</b>Link</span></div>
            <button class="nav on">Surplus</button>
        </aside>

        <main class="main">
            <h1>Kelola Produk Surplus</h1>
            <div class="pg">
                <div class="card">
                    <h2>Atur Metode Distribusi (Langkah 2/2)</h2>
                    
                    <% if (error) { %>
                        <p class="err" style="display:block;"><%= error %></p>
                    <% } %>

                    <div class="seg" style="margin: 20px 0;">
                        <!-- Tab Tidak Aktif, mengarah ke I-09 -->
                        <a href="/surplus/<%= idSurplus %>/donasi" style="text-decoration:none; flex:1;">
                            <button class="w">Donasi Gratis</button>
                        </a>
                        <!-- Tab Aktif -->
                        <a href="/surplus/<%= idSurplus %>/jual" style="text-decoration:none; flex:1;">
                            <button class="w on">Jual Diskon</button>
                        </a>
                    </div>

                    <form action="/surplus/<%= idSurplus %>/jual" method="POST">
                        <label>Harga Jual Diskon (Rp)</label>
                        <input type="number" name="harga" min="1000" placeholder="Misal: 5000" required>

                        <div style="margin-top: 24px;">
                            <button type="submit" class="btn w">Publikasikan Harga Diskon</button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
</body>
</html>