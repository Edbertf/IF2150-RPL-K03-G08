<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Metode Distribusi - FoodLink</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #79b549; --primary-dark: #4a6b36; --primary-soft: #e6f0df; --orange: #e8842e; --bg: #f7faf3; --surface: #ffffff; --text: #2f332c; --muted: #767c73; --border: #e5e9e1; --input-bg: #f4f7f1; --sidebar-width: 250px; } * { box-sizing: border-box; margin: 0; padding: 0; } html, body { min-height: 100%; } body { display: flex; min-height: 100vh; background-color: var(--bg); color: var(--text); font-family: 'Nunito', system-ui, sans-serif; -webkit-font-smoothing: antialiased; } .sidebar { position: sticky; top: 0; display: flex; flex: 0 0 var(--sidebar-width); flex-direction: column; width: var(--sidebar-width); height: 100vh; padding: 22px 20px 18px; overflow-y: auto; background-color: var(--surface); border-right: 1px solid var(--border); } .brand { display: flex; align-items: center; gap: 10px; margin-bottom: 34px; padding-left: 4px; text-decoration: none; } .brand-logo { display: block; width: 40px; height: 40px; } .brand-text { font-size: 21px; font-weight: 800; letter-spacing: -0.4px; line-height: 1; } .brand-text .food { color: var(--orange); } .brand-text .link { color: var(--primary); } .nav-menu { display: flex; flex-direction: column; gap: 6px; } .nav-item { display: flex; align-items: center; gap: 12px; padding: 11px 14px; border-radius: 8px; color: var(--muted); font-size: 15px; font-weight: 700; text-decoration: none; transition: 0.15s ease; } .nav-item svg { width: 20px; height: 20px; } .nav-item:hover { background-color: var(--input-bg); color: var(--primary-dark); } .nav-item.active { background-color: #e8f3df; color: #5f9136; } .user-profile { display: flex; align-items: center; gap: 12px; margin-top: auto; padding: 12px; border-radius: 10px; background-color: #f4f6f2; } .user-avatar { display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; background-color: #fdebd0; color: var(--orange); font-size: 15px; font-weight: 800; } .user-info { min-width: 0; } .user-info .name { font-size: 14px; font-weight: 800; } .user-info .role { color: var(--muted); font-size: 12px; font-weight: 600; } .main-content { flex: 1; width: 100%; padding: 40px 44px 64px; } .page-header { margin-bottom: 26px; } .greeting { color: var(--muted); font-size: 15px; font-weight: 600; } .page-header h1 { margin-top: 2px; font-size: 30px; font-weight: 800; letter-spacing: -0.6px; line-height: 1.2; } .btn { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 22px; border: none; border-radius: 8px; font-family: inherit; font-size: 14px; font-weight: 800; text-decoration: none; transition: 0.15s ease; cursor: pointer; } .btn-primary { background-color: var(--primary); color: #ffffff; } .btn-primary:hover { background-color: #6aa63f; } .btn-outline { background-color: transparent; border: 1px solid var(--border); color: var(--muted); } .btn-outline:hover { background-color: var(--input-bg); color: var(--text); } .btn-group { display: flex; gap: 12px; margin-bottom: 24px; } .btn-group .btn { flex: 1; } .btn-group .btn.active { background-color: var(--primary-soft); color: var(--primary-dark); border: 1px solid var(--primary-soft); } .content-grid { display: grid; grid-template-columns: 1fr; max-width: 700px; gap: 20px; align-items: start; } .card { padding: 22px 26px; background-color: var(--surface); border: 1px solid var(--border); border-radius: 12px; } .card-header { margin-bottom: 18px; } .card-title { font-size: 17px; font-weight: 800; letter-spacing: -0.2px; } .form-group { margin-bottom: 18px; } .form-label { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 700; color: var(--text); } .form-control { width: 100%; padding: 12px 16px; border: 1px solid var(--border); border-radius: 8px; background-color: var(--input-bg); font-family: inherit; font-size: 14px; color: var(--text); transition: all 0.2s ease; } .form-control:focus { outline: none; border-color: var(--primary); background-color: var(--surface); box-shadow: 0 0 0 3px var(--primary-soft); } .alert { padding: 14px 16px; margin-bottom: 20px; border-radius: 8px; font-size: 14px; font-weight: 600; } .alert-error { background-color: #fdebd0; color: var(--orange); } .alert-info { background-color: var(--input-bg); color: var(--muted); } @media (max-width: 860px) { body { flex-direction: column; } .sidebar { position: static; width: 100%; height: auto; flex: none; flex-direction: row; flex-wrap: wrap; align-items: center; padding: 14px 18px; } .main-content { padding: 28px 20px 48px; } .nav-menu { flex-direction: row; } }
    </style>
</head>
<body>
    <aside class="sidebar">
        <a class="brand" href="/fnb/dashboard">
            <img class="brand-logo" src="/logo.png" alt="" width="40" height="40">
            <span class="brand-text"><span class="food">Food</span><span class="link">Link</span></span>
        </a>
        <nav class="nav-menu">
            <a class="nav-item" href="/fnb/dashboard"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20V10m7 10V4m7 16v-7"/></svg><span>Dashboard</span></a>
            <a class="nav-item" href="/fnb/penjualan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6zM14 3v4h4"/></svg><span>Penjualan</span></a>
            <a class="nav-item active" href="/surplus/catat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10"/></svg><span>Surplus</span></a>
            <a class="nav-item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c0-4 4-6 8-6s8 2 8 6"/></svg><span>Profil</span></a>
        </nav>
        <div class="user-profile">
            <div class="user-avatar"><%= user.namaUsaha.charAt(0).toUpperCase() %></div>
            <div class="user-info">
                <div class="name"><%= user.namaUsaha %></div>
                <div class="role">Pemilik F&B</div>
            </div>
        </div>
    </aside>

    <main class="main-content">
        <header class="page-header">
            <div>
                <p class="greeting">Langkah Terakhir</p>
                <h1>Atur Metode Distribusi</h1>
            </div>
        </header>

        <div class="content-grid">
            <section class="card">
                <div class="card-header">
                    <h2 class="card-title">Pilih Cara Distribusi (Langkah 2/2)</h2>
                </div>

                <% if (error) { %>
                    <div class="alert alert-error"><%= error %></div>
                <% } %>

                <div class="btn-group">
                    <a href="/surplus/<%= idSurplus %>/donasi" class="btn btn-outline">Donasi Gratis</a>
                    <a href="/surplus/<%= idSurplus %>/jual" class="btn active">Jual Diskon</a>
                </div>

                <form action="/surplus/<%= idSurplus %>/jual" method="POST">
                    <div class="form-group">
                        <label class="form-label">Harga Jual Diskon (Rp)</label>
                        <input type="number" name="harga" class="form-control" min="1000" placeholder="Misal: 10000" required>
                    </div>
                    
                    <div style="margin-top: 32px; display: flex; justify-content: space-between;">
                        <a href="/surplus/catat" class="btn btn-outline">Kembali</a>
                        <button type="submit" class="btn btn-primary">Publikasikan Harga Diskon</button>
                    </div>
                </form>
            </section>
        </div>
    </main>
</body>
</html>