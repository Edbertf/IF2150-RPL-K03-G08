<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Surplus Dipublikasikan - FoodLink</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #79b549; --primary-dark: #639839; --bg: #f7f9f6; --surface: #ffffff; --text: #2f332c; --muted: #767c73; --border: #e5e9e1; --sidebar-width: 250px; --orange: #e8842e; --green-light: #eaf3e1; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { display: flex; min-height: 100vh; background-color: var(--bg); color: var(--text); font-family: 'Nunito', sans-serif; }
        
        .sidebar { position: fixed; width: var(--sidebar-width); height: 100vh; background-color: var(--surface); border-right: 1px solid var(--border); padding: 24px 20px; display: flex; flex-direction: column; }
        .brand { display: flex; align-items: center; gap: 8px; margin-bottom: 40px; text-decoration: none; padding-left: 8px; }
        .brand img { width: 32px; height: 32px; }
        .brand-text { font-size: 20px; font-weight: 800; }
        .brand-text .food { color: var(--orange); } .brand-text .link { color: var(--primary); }
        .nav-menu { display: flex; flex-direction: column; gap: 8px; }
        .nav-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 8px; color: var(--muted); font-size: 15px; font-weight: 700; text-decoration: none; }
        .nav-item.active { background-color: var(--green-light); color: var(--primary-dark); }
        .nav-item svg { width: 20px; height: 20px; stroke-width: 2.5; }
        .user-profile { margin-top: auto; display: flex; align-items: center; gap: 12px; padding: 12px; background-color: #f8f9f6; border-radius: 12px; }
        .user-avatar { width: 36px; height: 36px; background-color: #fdebd0; color: var(--orange); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800; }
        .user-info .name { font-size: 13px; font-weight: 800; color: var(--text); }
        .user-info .role { font-size: 11px; font-weight: 600; color: var(--muted); }

        .main-content { margin-left: var(--sidebar-width); flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px; text-align: center; }
        
        .success-circle { width: 88px; height: 88px; background-color: var(--green-light); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 24px; }
        .success-title { font-size: 28px; font-weight: 800; margin-bottom: 12px; }
        
        .badge-ngo { display: inline-block; background-color: var(--green-light); color: var(--primary-dark); padding: 4px 16px; border-radius: 20px; font-size: 12px; font-weight: 800; margin-bottom: 16px; }
        
        .success-desc { color: var(--muted); font-size: 14px; font-weight: 600; max-width: 400px; line-height: 1.5; margin-bottom: 32px; }

        .summary-card { width: 100%; max-width: 480px; background-color: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; margin-bottom: 24px; text-align: left; }
        .summary-row { display: flex; justify-content: space-between; padding: 10px 0; font-size: 14px; }
        .summary-row:not(:last-child) { border-bottom: 1px dashed var(--border); }
        .summary-label { color: var(--muted); font-weight: 600; }
        .summary-value { font-weight: 800; color: var(--text); }

        .btn-primary { display: flex; align-items: center; justify-content: center; width: 100%; max-width: 480px; height: 48px; border-radius: 8px; font-size: 15px; font-weight: 800; background-color: var(--primary); color: white; cursor: pointer; text-decoration: none; border: none; transition: opacity 0.2s; }
        .btn-primary:hover { opacity: 0.9; }
    </style>
</head>
<body>
    <aside class="sidebar">
        <a class="brand" href="#"><img src="/logo.png" alt=""><span class="brand-text"><span class="food">Food</span><span class="link">Link</span></span></a>
        <nav class="nav-menu">
            <a class="nav-item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg> Dashboard</a>
            <a class="nav-item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg> Penjualan</a>
            <a class="nav-item active" href="/surplus/catat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg> Surplus</a>
            <a class="nav-item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg> Profil</a>
        </nav>
        <div class="user-profile">
            <div class="user-avatar">B</div>
            <div class="user-info"><div class="name">Bakery Sinar Pagi</div><div class="role">Pemilik F&B</div></div>
        </div>
    </aside>

    <main class="main-content">
        <div class="success-circle">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>
        
        <h1 class="success-title">Surplus Dipublikasikan</h1>
        
        <div class="badge-ngo">
            <%= typeof result !== 'undefined' && result.metode === 'diskon' ? 'Terlihat oleh Konsumen Umum' : 'Terlihat oleh NGO' %>
        </div>
        
        <p class="success-desc">
            Produk surplus sudah muncul di daftar <%= typeof result !== 'undefined' && result.metode === 'diskon' ? 'pembeli' : 'NGO' %> terdekat. Anda akan diberi tahu saat ada klaim.
        </p>

        <div class="summary-card">
            <div class="summary-row">
                <span class="summary-label">Produk</span>
                <span class="summary-value"><%= typeof result !== 'undefined' ? result.namaProduk : 'Roti Tawar' %></span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Jumlah</span>
                <span class="summary-value"><%= typeof result !== 'undefined' ? result.jumlah : '12' %> porsi</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Metode</span>
                <span class="summary-value"><%= typeof result !== 'undefined' && result.metode === 'diskon' ? 'Jual Diskon' : 'Donasi Gratis' %></span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Ambil sebelum</span>
                <span class="summary-value"><%= typeof result !== 'undefined' ? result.ambilSebelum : 'Hari ini, 20.00' %></span>
            </div>
        </div>

        <a href="/" class="btn-primary">Ke Dashboard</a>
    </main>

</body>
</html>