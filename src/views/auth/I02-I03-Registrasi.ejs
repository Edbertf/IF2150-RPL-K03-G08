<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Daftar Akun - FoodLink</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #79b549;
            --primary-dark: #4f8a1f;
            --primary-soft: #e8f2dc;
            --text: #2f332c;
            --muted: #767c73;
            --bg: #f6f8f2;
            --border: #e3e8dc;
            --danger: #c0392b;
            --danger-soft: #fdecea;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            background-color: var(--bg);
            color: var(--text);
            font-family: 'Nunito', system-ui, sans-serif;
            font-size: 15px;
            -webkit-font-smoothing: antialiased;
        }

        .wrap {
            width: 100%;
            max-width: 524px;
            margin: 0 auto;
            padding: 56px 20px 72px;
        }

        .head {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 26px;
        }

        .back {
            display: grid;
            place-items: center;
            flex: 0 0 42px;
            width: 42px;
            height: 42px;
            border: 1px solid var(--border);
            border-radius: 50%;
            background-color: #ffffff;
            color: var(--text);
            text-decoration: none;
        }

        .back:hover {
            border-color: var(--primary);
            color: var(--primary-dark);
        }

        h1 {
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .seg {
            display: flex;
            gap: 4px;
            padding: 5px;
            border-radius: 14px;
            background-color: var(--primary-soft);
        }

        .seg a {
            flex: 1;
            padding: 10px;
            border-radius: 10px;
            color: var(--muted);
            font-weight: 700;
            text-align: center;
            text-decoration: none;
        }

        .seg a.on {
            background-color: #ffffff;
            color: var(--primary-dark);
            font-weight: 800;
            box-shadow: 0 1px 4px rgba(42, 58, 32, 0.08);
        }

        .ringkas {
            margin-top: 16px;
            padding: 12px 16px;
            border-radius: 12px;
            background-color: var(--danger-soft);
            color: var(--danger);
            font-size: 14px;
            font-weight: 700;
        }

        label {
            display: block;
            margin: 16px 0 6px;
            font-size: 13px;
            font-weight: 800;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 13px 15px;
            border: 1.5px solid var(--border);
            border-radius: 13px;
            background-color: #ffffff;
            color: var(--text);
            font: inherit;
            outline: none;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-soft);
        }

        input.bad {
            border-color: var(--danger);
        }

        .err {
            margin-top: 6px;
            color: var(--danger);
            font-size: 13px;
            font-weight: 700;
        }

        .drop {
            display: block;
            margin-top: 22px;
            padding: 26px 20px;
            border: 2px dashed var(--primary);
            border-radius: 16px;
            background-color: #ffffff;
            color: var(--primary-dark);
            text-align: center;
            cursor: pointer;
        }

        .drop:hover {
            background-color: #fbfdf8;
        }

        .drop svg {
            display: block;
            margin: 0 auto 6px;
        }

        .drop b {
            display: block;
            font-size: 15px;
            font-weight: 800;
            word-break: break-word;
        }

        .drop small {
            display: block;
            margin-top: 4px;
            color: var(--muted);
            font-size: 12.5px;
            font-weight: 600;
        }

        .btn {
            display: block;
            width: 100%;
            margin-top: 22px;
            padding: 15px 24px;
            border: 0;
            border-radius: 14px;
            background-color: var(--primary);
            color: #ffffff;
            font: inherit;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
        }

        .btn:hover {
            filter: brightness(0.95);
        }

        .back:focus-visible,
        .seg a:focus-visible,
        .btn:focus-visible {
            outline: 3px solid rgba(121, 181, 73, 0.35);
            outline-offset: 2px;
        }

        .hidden {
            display: none;
        }

        @media (max-width: 560px) {
            .wrap {
                padding: 32px 18px 56px;
            }

            h1 {
                font-size: 26px;
            }
        }
    </style>
</head>
<body>
<%
    const fnb = tipe !== 'ngo';
    const labelDokumen = fnb ? 'Unggah NIB / Izin Usaha' : 'Unggah Akta / SK Kemenkumham';
    const isian = old || {};
    const galat = errorField || {};
    const nilai = (kunci) => (isian[kunci] ? isian[kunci] : '');
    const salah = (kunci) => Boolean(galat[kunci]);
%>
    <main class="wrap">
        <div class="head">
            <a class="back" href="/" aria-label="Kembali ke beranda">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5m6-7-7 7 7 7"/>
                </svg>
            </a>
            <h1>Daftar Akun</h1>
        </div>

        <nav class="seg" aria-label="Pilih tipe akun">
            <a class="<%= fnb ? 'on' : '' %>" href="/daftar?tipe=fnb"
               <% if (fnb) { %>aria-current="page"<% } %>>Pemilik F&amp;B</a>
            <a class="<%= fnb ? '' : 'on' %>" href="/daftar?tipe=ngo"
               <% if (!fnb) { %>aria-current="page"<% } %>>Perwakilan NGO</a>
        </nav>

        <% if (Object.keys(galat).length > 0) { %>
            <p class="ringkas" role="alert">Periksa kembali isian yang ditandai merah.</p>
        <% } %>

        <form action="/daftar" method="POST" enctype="multipart/form-data" novalidate>
            <input type="hidden" name="tipeAkun" value="<%= fnb ? 'pemilik_fnb' : 'perwakilan_ngo' %>">

            <% if (fnb) { %>
                <label for="namaUsaha">Nama Usaha</label>
                <input id="namaUsaha" name="namaUsaha" type="text"
                       class="<%= salah('namaUsaha') ? 'bad' : '' %>"
                       value="<%= nilai('namaUsaha') %>" placeholder="Bakery Sinar Pagi"
                       autocomplete="organization">
                <% if (salah('namaUsaha')) { %><p class="err" role="alert"><%= galat.namaUsaha %></p><% } %>
            <% } else { %>
                <label for="namaOrganisasi">Nama Organisasi</label>
                <input id="namaOrganisasi" name="namaOrganisasi" type="text"
                       class="<%= salah('namaOrganisasi') ? 'bad' : '' %>"
                       value="<%= nilai('namaOrganisasi') %>" placeholder="Yayasan Berbagi Kasih"
                       autocomplete="organization">
                <% if (salah('namaOrganisasi')) { %><p class="err" role="alert"><%= galat.namaOrganisasi %></p><% } %>
            <% } %>

            <label for="email">Email</label>
            <input id="email" name="email" type="email"
                   class="<%= salah('email') ? 'bad' : '' %>"
                   value="<%= nilai('email') %>" placeholder="nama@contoh.com"
                   autocomplete="email">
            <% if (salah('email')) { %><p class="err" role="alert"><%= galat.email %></p><% } %>

            <% if (fnb) { %>
                <label for="alamatUsaha">Alamat Usaha</label>
                <input id="alamatUsaha" name="alamatUsaha" type="text"
                       class="<%= salah('alamatUsaha') ? 'bad' : '' %>"
                       value="<%= nilai('alamatUsaha') %>" placeholder="Jl. Ir. H. Juanda No. 45, Bandung">
                <% if (salah('alamatUsaha')) { %><p class="err" role="alert"><%= galat.alamatUsaha %></p><% } %>

                <label for="jamOperasional">Jam Operasional</label>
                <input id="jamOperasional" name="jamOperasional" type="text"
                       class="<%= salah('jamOperasional') ? 'bad' : '' %>"
                       value="<%= nilai('jamOperasional') %>" placeholder="08.00-20.00">
                <% if (salah('jamOperasional')) { %><p class="err" role="alert"><%= galat.jamOperasional %></p><% } %>
            <% } else { %>
                <label for="nomorLegalitas">Nomor Legalitas</label>
                <input id="nomorLegalitas" name="nomorLegalitas" type="text"
                       class="<%= salah('nomorLegalitas') ? 'bad' : '' %>"
                       value="<%= nilai('nomorLegalitas') %>" placeholder="AHU-0000001.AH.01.01.TAHUN 2026">
                <% if (salah('nomorLegalitas')) { %><p class="err" role="alert"><%= galat.nomorLegalitas %></p><% } %>

                <label for="lokasi">Alamat Kantor</label>
                <input id="lokasi" name="lokasi" type="text"
                       class="<%= salah('lokasi') ? 'bad' : '' %>"
                       value="<%= nilai('lokasi') %>" placeholder="Jl. Braga No. 12, Bandung">
                <% if (salah('lokasi')) { %><p class="err" role="alert"><%= galat.lokasi %></p><% } %>
            <% } %>

            <label for="kataSandi">Kata Sandi</label>
            <input id="kataSandi" name="kataSandi" type="password"
                   class="<%= salah('kataSandi') ? 'bad' : '' %>"
                   value="" placeholder="Minimal 8 karakter" autocomplete="new-password">
            <% if (salah('kataSandi')) { %><p class="err" role="alert"><%= galat.kataSandi %></p><% } %>

            <label class="drop" for="dokumen">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 16V4m-5 5 5-5 5 5M4 20h16"/>
                </svg>
                <b id="namaBerkas" data-label="<%= labelDokumen %>"><%= labelDokumen %></b>
                <small>PDF, JPG, PNG &middot; maks 5 MB</small>
            </label>
            <input id="dokumen" name="dokumen" type="file"
                   accept=".pdf,.jpg,.jpeg,.png" class="hidden">
            <% if (salah('dokumen')) { %><p class="err" role="alert"><%= galat.dokumen %></p><% } %>

            <button class="btn" type="submit">Daftar</button>
        </form>
    </main>

    <script>
        (function () {
            var input = document.getElementById('dokumen');
            var label = document.getElementById('namaBerkas');
            if (!input || !label) return;

            input.addEventListener('change', function () {
                label.textContent = this.files && this.files[0]
                    ? this.files[0].name
                    : label.dataset.label;
            });
        })();
    </script>
</body>
</html>