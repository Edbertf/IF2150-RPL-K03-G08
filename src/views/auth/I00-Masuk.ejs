<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Masuk - FoodLink</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #79b549;
            --primary-dark: #4f8a1f;
            --primary-soft: #e8f2dc;
            --text: #2f332c;
            --muted: #767c73;
            --bg: #f6f8f2;
            --border: #e3e8dc;
            --danger: #c0392b;
            --danger-soft: #fdecea;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            background-color: var(--bg);
            color: var(--text);
            font-family: 'Nunito', system-ui, sans-serif;
            font-size: 15px;
            -webkit-font-smoothing: antialiased;
        }

        .kartu {
            width: 100%;
            max-width: 420px;
            padding: 34px 30px 30px;
            border: 1px solid var(--border);
            border-radius: 20px;
            background-color: #ffffff;
        }

        .brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 22px;
            text-decoration: none;
        }

        .brand img { width: 40px; height: 40px; }
        .brand span { font-size: 22px; font-weight: 800; letter-spacing: -0.4px; }
        .brand .food { color: #e8842e; }
        .brand .link { color: var(--primary); }

        h1 { font-size: 24px; font-weight: 800; text-align: center; }
        .sub { margin: 6px 0 20px; color: var(--muted); text-align: center; font-size: 14px; }

        label { display: block; margin: 14px 0 6px; font-size: 13px; font-weight: 800; }

        input {
            width: 100%;
            padding: 13px 15px;
            border: 1.5px solid var(--border);
            border-radius: 13px;
            background-color: #ffffff;
            color: var(--text);
            font: inherit;
            outline: none;
        }

        input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-soft);
        }

        .galat {
            margin-top: 16px;
            padding: 11px 14px;
            border-radius: 12px;
            background-color: var(--danger-soft);
            color: var(--danger);
            font-size: 13.5px;
            font-weight: 700;
        }

        .btn {
            display: block;
            width: 100%;
            margin-top: 20px;
            padding: 14px 24px;
            border: 0;
            border-radius: 14px;
            background-color: var(--primary);
            color: #ffffff;
            font: inherit;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
        }

        .btn:hover { filter: brightness(0.95); }

        .bawah { margin-top: 18px; text-align: center; color: var(--muted); font-size: 14px; }
        .bawah a { color: var(--primary-dark); font-weight: 800; text-decoration: none; }
        .bawah a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <main class="kartu">
        <a class="brand" href="/">
            <img src="/assets/logo.png" alt="" width="40" height="40">
            <span><span class="food">Food</span><span class="link">Link</span></span>
        </a>

        <h1>Masuk</h1>
        <p class="sub">Gunakan akun yang sudah diverifikasi admin.</p>

        <% if (error) { %>
            <p class="galat" role="alert"><%= error %></p>
        <% } %>

        <form action="/masuk" method="POST" novalidate>
            <label for="email">Email</label>
            <input id="email" name="email" type="email" value="<%= old.email || '' %>"
                   placeholder="nama@contoh.com" autocomplete="email" autofocus>

            <label for="kataSandi">Kata Sandi</label>
            <input id="kataSandi" name="kataSandi" type="password"
                   placeholder="Kata sandi" autocomplete="current-password">

            <button class="btn" type="submit">Masuk</button>
        </form>

        <p class="bawah">Belum punya akun? <a href="/daftar">Daftar sekarang</a></p>
    </main>
</body>
</html>