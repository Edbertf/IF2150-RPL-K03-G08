<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Klaim Berhasil - FoodLink</title>

    <link rel="stylesheet" href="/css/ngo-uc10.css">
</head>

<body>
    <div class="app-container">

        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="brand">
                <img src="/assets/logo.png" alt="FoodLink">
                <span><strong>Food</strong>Link</span>
            </div>

            <nav class="sidebar-menu">
                <a href="/ngo" class="menu-item">
                    <span>⌂</span> Beranda
                </a>

                <a href="/ngo/klaim" class="menu-item active">
                    <span>⬡</span> Klaim Saya
                </a>

                <a href="/ngo/profil" class="menu-item">
                    <span>♙</span> Profil
                </a>
            </nav>

            <div class="profile-card">
                <div class="profile-avatar">Y</div>
                <div>
                    <strong>
                        <%= surplus.namaOrganisasi %>
                    </strong>
                    <small>Perwakilan NGO</small>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">

            <section class="success-content">

                <div class="success-icon">
                    ✓
                </div>

                <h1>Klaim Berhasil!</h1>

                <span class="success-badge">
                    Terklaim
                </span>

                <p class="success-description">
                    Tunjukkan kode klaim ke pemilik usaha
                    saat mengambil makanan.
                </p>

                <!-- Ringkasan Klaim -->
                <div class="success-summary">

                    <div class="summary-row">
                        <span>Produk</span>
                        <strong>
                            <%= surplus.namaProduk %>
                        </strong>
                    </div>

                    <div class="summary-row">
                        <span>Jumlah</span>
                        <strong>
                            <%= surplus.jumlah %>
                            <%= surplus.satuan %>
                        </strong>
                    </div>

                    <div class="summary-row">
                        <span>Kode klaim</span>
                        <strong class="claim-code">
                            <%= hasilKlaim.kodeKlaim %>
                        </strong>
                    </div>

                    <div class="summary-row">
                        <span>Ambil sebelum</span>
                        <strong>
                            <%= surplus.batasWaktuSingkat %>
                        </strong>
                    </div>

                </div>

                <!-- Actions -->
                <div class="success-actions">

                    <button
                        type="button"
                        class="btn-primary"
                        id="confirmPickup">

                        Konfirmasi Pengambilan

                    </button>

                    <button
                        type="button"
                        class="btn-outline"
                        onclick="history.back()">

                        Kembali ke Daftar

                    </button>

                </div>

            </section>

        </main>
    </div>

    <script>
        document
            .getElementById('confirmPickup')
            .addEventListener('click', () => {

                alert(
                    'Halaman konfirmasi pengambilan akan dihubungkan pada implementasi UC11.'
                );

            });
    </script>

</body>
</html>
