<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Pengambilan Selesai - FoodLink</title>

    <link rel="stylesheet" href="/css/ngo-uc10.css">
</head>

<body>
    <div class="app-container">

        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="brand">
                <img src="/assets/logo.png" alt="FoodLink">
                <span><strong>Food</strong>Link</span>
            </div>

            <nav class="sidebar-menu">
                <a href="/ngo" class="menu-item">
                    <span>⌂</span> Beranda
                </a>

                <a href="/ngo/klaim" class="menu-item">
                    <span>⬡</span> Klaim Saya
                </a>

                <a href="/ngo/profil" class="menu-item">
                    <span>♙</span> Profil
                </a>
            </nav>

            <div class="profile-card">
                <div class="profile-avatar">Y</div>

                <div>
                    <strong>
                        <%= pengambilan.dataNgo.namaOrganisasi %>
                    </strong>
                    <small>Perwakilan NGO</small>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">

            <section class="success-content">

                <div class="success-icon">
                    ♥
                </div>

                <h1>Pengambilan Selesai!</h1>

                <span class="success-badge">
                    Selesai
                </span>

                <p class="success-description">
                    Terima kasih telah membantu mengurangi
                    pemborosan makanan. Pengambilan produk surplus
                    berhasil dikonfirmasi.
                </p>

                <div class="success-actions">

                    <a
                        href="/ngo"
                        class="btn-primary">

                        Kembali ke Daftar

                    </a>

                </div>

            </section>

        </main>
    </div>
</body>
</html>