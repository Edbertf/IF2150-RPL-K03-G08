<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Produk - FoodLink</title>

    <link rel="stylesheet" href="/css/ngo-uc10.css">
</head>

<body>
    <div class="app-container">

        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="brand">
                <img src="/assets/logo.png" alt="FoodLink">
                <span><strong>Food</strong>Link</span>
            </div>

            <nav class="sidebar-menu">
                <a href="/ngo" class="menu-item active">
                    <span>⌂</span> Beranda
                </a>

                <a href="/ngo/klaim" class="menu-item">
                    <span>⬡</span> Klaim Saya
                </a>

                <a href="/ngo/profil" class="menu-item">
                    <span>♙</span> Profil
                </a>
            </nav>

            <div class="profile-card">
                <div class="profile-avatar">Y</div>
                <div>
                    <strong><%= surplus.namaOrganisasi || 'Yayasan Berbagi Kasih' %></strong>
                    <small>Perwakilan NGO</small>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">

            <header class="page-header">
                <button class="back-button"
                        type="button"
                        onclick="history.back()">
                    ←
                </button>

                <h1>Detail Produk</h1>
            </header>

            <section class="detail-layout">

                <!-- Product Image -->
                <div class="product-image">
                    <div class="image-placeholder">
                        🍴
                    </div>
                </div>

                <!-- Product Information -->
                <div class="product-card">

                    <div class="product-tags">
                        <span class="tag">
                            <%= surplus.kategori %>
                        </span>

                        <span class="tag">
                            <%= surplus.jenisDistribusi === 'Donasi'
                                ? 'Donasi Gratis'
                                : 'Jual Diskon' %>
                        </span>
                    </div>

                    <h2><%= surplus.namaProduk %></h2>

                    <p class="business-name">
                        ♜ <%= surplus.namaUsaha %>
                    </p>

                    <div class="product-info">

                        <div class="info-item">
                            <div class="info-icon">⬡</div>

                            <div>
                                <small>Jumlah tersedia</small>
                                <strong>
                                    <%= surplus.jumlah %>
                                    <%= surplus.satuan || 'porsi' %>
                                </strong>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">♧</div>

                            <div>
                                <small>Lokasi</small>
                                <strong>
                                    <%= surplus.alamatUsaha %>
                                    · <%= surplus.jarak %>
                                </strong>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">◷</div>

                            <div>
                                <small>Batas pengambilan</small>
                                <strong class="deadline">
                                    <%= surplus.batasWaktuTampil %>
                                </strong>
                            </div>
                        </div>

                    </div>

                    <!-- Map Placeholder -->
                    <div class="map-placeholder">
                        <span>♧</span>
                        <strong>Peta lokasi pengambilan</strong>
                    </div>

                    <!-- Claim Button -->
                    <button
                        type="button"
                        class="btn-primary"
                        id="openClaimModal">

                        Ajukan Klaim

                    </button>

                </div>

            </section>

        </main>
    </div>

    <!-- Modal N5 -->
    <%- include('partials/N5-KonfirmasiKlaim', { surplus }) %>

    <script>
        const claimModal = document.getElementById('claimModal');

        const openModalButton =
            document.getElementById('openClaimModal');

        const closeModalButton =
            document.getElementById('cancelClaim');

        openModalButton.addEventListener('click', () => {
            claimModal.hidden = false;
        });

        closeModalButton.addEventListener('click', () => {
            claimModal.hidden = true;
        });

        claimModal.addEventListener('click', (event) => {
            if (event.target === claimModal) {
                claimModal.hidden = true;
            }
        });
    </script>

</body>
</html>
