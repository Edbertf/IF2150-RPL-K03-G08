<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FoodLink - Selamat Datang</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #79b549;
            --primary-dark: #4f8a1f;
            --primary-soft: #e8f2dc;
            --orange: #e8842e;
            --text: #2f332c;
            --muted: #767c73;
            --bg: #f6f8f2;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: 'Nunito', system-ui, sans-serif;
            font-size: 15px;
            -webkit-font-smoothing: antialiased;
        }

        .welcome {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            min-height: 100vh;
        }

        /* ---------- Kiri: brand ---------- */
        .wl {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px;
            text-align: center;
            background: linear-gradient(160deg, #eef6e2, #fdeede);
        }

        .wl img {
            display: block;
            width: 190px;
            height: auto;
            mix-blend-mode: multiply;
        }

        .wl h1 {
            margin-top: 8px;
            color: var(--orange);
            font-size: 54px;
            font-weight: 800;
            letter-spacing: -1px;
            line-height: 1;
        }

        .wl h1 b {
            color: var(--primary);
        }

        .wl p {
            max-width: 380px;
            margin-top: 12px;
            color: var(--muted);
            font-size: 18px;
            line-height: 1.45;
        }

        /* ---------- Kanan: masuk ---------- */
        .wr {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 14px;
            width: 100%;
            max-width: 430px;
            margin: auto;
            padding: 30px;
            text-align: center;
        }

        .wr h2 {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.3px;
        }

        .wr > span {
            color: var(--muted);
        }

        .btn {
            display: block;
            width: 100%;
            padding: 14px 24px;
            border: 1.5px solid transparent;
            border-radius: 14px;
            background-color: var(--primary);
            color: #ffffff;
            font-family: inherit;
            font-size: 15px;
            font-weight: 800;
            line-height: 1.2;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            transition: filter 0.15s ease, background-color 0.15s ease;
        }

        .btn:hover {
            filter: brightness(0.95);
        }

        .btn.o {
            background-color: var(--orange);
        }

        .btn.ol {
            background-color: #ffffff;
            border-color: var(--primary);
            color: var(--primary-dark);
        }

        .btn.ol:hover {
            background-color: var(--primary-soft);
            filter: none;
        }

        .btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            filter: none;
        }

        .btn:focus-visible,
        .lnk:focus-visible {
            outline: 3px solid rgba(121, 181, 73, 0.35);
            outline-offset: 2px;
        }

        .lnk {
            color: var(--primary-dark);
            font-weight: 800;
            text-decoration: none;
        }

        .lnk:hover {
            text-decoration: underline;
        }

        /* ---------- Responsif ---------- */
        @media (max-width: 980px) {
            .welcome {
                grid-template-columns: 1fr;
            }

            .wl {
                min-height: 240px;
                padding: 28px;
            }

            .wl img {
                width: 120px;
            }

            .wl h1 {
                font-size: 38px;
            }

            .wr {
                padding: 34px 24px 48px;
            }
        }
    </style>
</head>
<body>
    <main class="welcome">
        <section class="wl">
            <img src="/assets/logo.png" alt="FoodLink" width="190" height="190">
            <h1>Food<b>Link</b></h1>
            <p>Hubungkan makanan surplus dengan mereka yang membutuhkan.</p>
        </section>

        <%
            const sudahMasuk = (typeof pengguna !== 'undefined' && pengguna) ? pengguna : null;
            const labelPeran = sudahMasuk
                ? (sudahMasuk.role === 'pemilik_fnb'
                    ? 'Pemilik F&B'
                    : (sudahMasuk.role === 'perwakilan_ngo' ? 'Perwakilan NGO' : 'Admin Sistem'))
                : '';
        %>
        <section class="wr">
            <% if (!sudahMasuk) { %>
                <h2>Selamat datang</h2>
                <span>Masuk sebagai</span>

                <a class="btn" href="/masuk">Pemilik F&amp;B</a>
                <a class="btn o" href="/masuk">Perwakilan NGO</a>
                <a class="btn ol" href="/masuk">Admin Sistem</a>

                <span>Belum punya akun? <a class="lnk" href="/daftar">Daftar sekarang</a></span>
            <% } else { %>
                <h2>Halo, <%= sudahMasuk.nama %></h2>
                <span>Anda sudah masuk sebagai <%= labelPeran %>.</span>

                <% if (sudahMasuk.role === 'pemilik_fnb') { %>
                    <%# TODO UC05 (PR #14): arahkan ke /fnb/dashboard setelah tersedia. %>
                    <a class="btn" href="/fnb/penjualan">Buka Halaman Penjualan</a>
                <% } %>

                <% if (sudahMasuk.role === 'pemilik_fnb' || sudahMasuk.role === 'perwakilan_ngo') { %>
                    <a class="btn ol" href="/status">Lihat Status Pendaftaran</a>
                <% } %>

                <% if (sudahMasuk.role === 'admin_sistem') { %>
                    <a class="btn o" href="/admin/verifikasi">Buka Verifikasi Pendaftar</a>
                <% } %>

                <form action="/keluar" method="POST">
                    <button class="btn ol" type="submit">Keluar</button>
                </form>
            <% } %>
        </section>
    </main>
</body>
</html>